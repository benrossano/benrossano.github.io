{%- comment -%}
  Site-owned include: basketball + golf icons for the "sports" popup.
  Hand-drawn inline SVG -- `fa-basketball` is not in the free FontAwesome set
  this site loads. Golf reads as a pin-and-ball rather than a ball on a tee,
  which stays legible at 34px.
  NOTE: this file must not end in a newline (see pop-styles.liquid).
{%- endcomment -%}
<span class="pop-card" id="pop-sports" role="tooltip">
  <span class="pop-icons">
    <span class="pop-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9.2" />
        <path d="M12 2.8v18.4M2.8 12h18.4" />
        <path d="M5.5 5.5c2.7 2.7 2.7 10.3 0 13" />
        <path d="M18.5 5.5c-2.7 2.7-2.7 10.3 0 13" />
      </svg>
      <span>basketball</span>
    </span>
    <span class="pop-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6.4 20.2h11.2" />
        <path d="M12.4 20.2V3.4" />
        <path d="M12.4 3.4l6.4 2.3-6.4 2.3z" fill="currentColor" />
        <circle cx="8.2" cy="18.3" r="1.7" />
      </svg>
      <span>golf</span>
    </span>
  </span>
</span>