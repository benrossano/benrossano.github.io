{%- comment -%}
  Site-owned include: world map for the "travelling" popup.

  The map (_includes/world-map.liquid) is static geometry with one
  <path id="c-XXX"> per country, keyed by ISO 3166-1 alpha-3. The visited set
  lives in _data/travel.yml; the CSS rule that highlights it is emitted by
  pop-styles.liquid, NOT here -- a <style> element is invalid inside a <p>.

  NOTE: no trailing newline, and the caller must wrap this in {::nomarkdown}
  so kramdown does not lowercase `viewBox` or split the paragraph.
{%- endcomment -%}
{%- assign visited = site.data.travel.visited -%}
<span class="pop-card pop-card--map" id="pop-travel" role="tooltip">{% include world-map.liquid %}<span class="pop-caption">{% if visited and visited.size > 0 %}{{ visited.size }} {% if visited.size == 1 %}country{% else %}countries{% endif %} visited{% else %}countries visited{% endif %}</span></span>